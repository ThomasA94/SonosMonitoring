<section class="panel source-card">
    <div class="section-heading"><h3>@Title</h3><SourceBadge Source="Source" /></div>
    <dl><dt>@Text["LastAttempt"]</dt><dd>@Text.Time(Source.LastAttemptUtc)</dd><dt>@Text["LastSuccess"]</dt><dd>@Text.Time(Source.LastSuccessUtc)</dd></dl>
    @if (Source.ErrorCode is not null) { <p class="muted">@Text[Source.ErrorCode is "monitoring_disabled" or "policy_unavailable" or "unsupported" or "not_supported" or "diagnostics_not_due" ? SonosMonitoring.Web.Components.Collection.DevicePresentation.Status(Source) + "Hint" : "RequestFailed"]</p><p class="technical-code">@Source.ErrorCode</p> }
</section>

@code {
    /// <summary>Gets or sets the localized source label.</summary>
    [Parameter] public string Title { get; set; } = "";
    /// <summary>Gets or sets the independently collected source state.</summary>
    [Parameter, EditorRequired] public SourceSnapshotDto Source { get; set; } = null!;
}
