<span class="source-badge @Status" title="@Text.Time(Source.LastSuccessUtc)"><span class="status-dot"></span>@Text[Status]</span>

@code {
    /// <summary>Gets or sets the backend-owned source quality.</summary>
    [Parameter, EditorRequired] public SourceSnapshotDto Source { get; set; } = null!;
    /// <summary>Gets a presentation category without inferring device or playback health.</summary>
    private string Status => SonosMonitoring.Web.Components.Collection.DevicePresentation.Status(this.Source);
}
