<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="github-sharedshelf01" value="https://nuget.pkg.github.com/DevboneFrameworks/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="github-sharedshelf01"><package pattern="Devbone.*" /></packageSource>
        <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    </packageSourceMapping>
</configuration>
