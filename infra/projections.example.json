{
  "EventProjection": {
    "Transport": "rabbitmq",
    "Mongo": {
      "ConnectionString": "mongodb://127.0.0.1:48017/?replicaSet=rs0&directConnection=true",
      "DatabaseName": "sonosmonitoring_dev"
    },
    "ControlPlane": {
      "DeploymentId": "sonosmonitoring-dev-projections",
      "Revision": "local",
      "HeartbeatInterval": "00:00:15",
      "LeaseDuration": "00:00:45",
      "LeaseGracePeriod": "00:00:05"
    },
    "InternalAddressPrefix": "sonosmonitoring.dev",
    "RabbitMq": {
      "HostName": "127.0.0.1",
      "Port": 48672,
      "UserName": "sonosmonitoring_dev",
      "Password": "<generated-in-.local/dev.env>",
      "VirtualHost": "/",
      "DomainExchangeName": "sonosmonitoring.events",
      "QueuePrefix": "sonosmonitoring-dev",
      "UseSingleActiveConsumer": true
    },
    "Aggregates": [
      {
        "AggregateName": "DeviceMonitoring",
        "SourceAddress": "sonosmonitoring.device-monitoring.events"
      }
    ]
  }
}
