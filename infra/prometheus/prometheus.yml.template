global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/sonos-alerts.yml

scrape_configs:
  - job_name: sonosmonitoring-api
    metrics_path: /metrics
    static_configs:
      - targets: ['__SCRAPE_TARGET__']
    http_headers:
      X-Api-Key:
        files:
          - /run/secrets/sonosmonitoring_api_key
